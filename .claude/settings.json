{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dart pub get)",
      "Bash(dart format *)",
      "Bash(dart analyze *)",
      "Bash(dart test *)",
      "Bash(dart run bin/main.dart *)",
      "Bash(dart pub publish --dry-run)"
    ],
    "deny": [
      "Bash(dart pub publish)",
      "Bash(dart pub publish --force *)"
    ]
  }
}
